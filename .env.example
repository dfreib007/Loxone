# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Loxone Miniserver ---
LOXONE_HOST=miniserver.local
LOXONE_PORT=80
LOXONE_USER=voice-app
LOXONE_PASSWORD=change-me

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:abc...
TELEGRAM_ALLOWED_USER_IDS=12345678,87654321

# --- Speech-to-Text (Phase 4, optional) ---
# OPENAI_API_KEY=sk-...
# WHISPER_ENDPOINT=http://whisper.local:9000

# --- Runtime ---
LOG_LEVEL=INFO
AUDIT_LOG_PATH=audit.jsonl
