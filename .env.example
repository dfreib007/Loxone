# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Loxone Miniserver ---
LOXONE_HOST=miniserver.local
# Leave LOXONE_PORT empty to auto-pick (443 with HTTPS, 80 with HTTP).
# LOXONE_PORT=443
LOXONE_USE_HTTPS=true
# Miniservers ship with a self-signed cert; leave verify off unless you've
# installed a CA-signed certificate on the device.
LOXONE_VERIFY_TLS=false
LOXONE_USER=voice-app
LOXONE_PASSWORD=change-me

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:abc...
TELEGRAM_ALLOWED_USER_IDS=12345678,87654321

# --- Speech-to-Text (Phase 4, optional) ---
# OPENAI_API_KEY=sk-...
# WHISPER_ENDPOINT=http://whisper.local:9000

# --- Runtime ---
LOG_LEVEL=INFO
AUDIT_LOG_PATH=audit.jsonl
